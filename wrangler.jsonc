// Статика на Cloudflare Workers. Скрипта воркера нет — только раздача файлов.
//
// Почему Workers, а не Pages: Cloudflare с 2025 года ведёт новые проекты сюда,
// в Pages идут только исправления.
//
// _site/ собирает пайплайн: туда кладутся сгенерированные PDF, их превью в
// webp, собранная страница и шрифты. Локально этой папки нет.
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cv-cosmdandy-dev",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
